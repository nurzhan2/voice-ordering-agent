# Copy to .env. The local defaults below are enough for `make dev` and `make test`;
# scripts/deploy.sh refuses to run while any *_change_me value is still present.

# --- Models ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- LiveKit: cloud or self-hosted ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telephony (SIP provider) ---
NOVOFON_SIP_HOST=sip.novofon.ru
NOVOFON_SIP_USER=
NOVOFON_SIP_PASSWORD=
NOVOFON_PHONE=

# --- Messengers ---
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=

# --- Restaurant POS ---
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=

# --- Infrastructure ---
DOMAIN=
ACME_EMAIL=
POSTGRES_USER=tarelka
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=tarelka
DATABASE_URL=postgresql://tarelka:change_me_please@postgres:5432/tarelka
REDIS_URL=redis://redis:6379/0
BACKEND_TOKEN=internal_service_token_change_me
BACKEND_URL=http://backend:8000

# --- Agent behaviour ---
LLM_MODEL=gpt-4.1-mini
STT_MODEL=nova-3
TTS_MODEL=eleven_flash_v2_5
MAX_REPLY_TOKENS=120
MAX_TOOL_STEPS=3
MIN_WAIT=0.35
MAX_WAIT=2.0
